#include <stdio.h>

int main()
{
    int L, R;
    int count = 0;
    scanf("%d %d", &L, &R);

    for (int i = L; i <= R; i++)
    {
        int n = i;

        while (n > 0)
        {
            if (n % 10 == 2)
            {
                count++;
            }
            n = n / 10;
        }
    }
    printf("%d\n", count);
    return 0;
}
