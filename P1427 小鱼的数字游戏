#include <stdio.h>

int main()
{
    int a[100];
    int n = 0;
    int x;

    while (1)
    {
        scanf("%d", &x);

        if (x == 0)
        {
            break;
        }
        a[n] = x;
        n++;
    }

    for (int i = n - 1; i >= 0; i--)
    {
        printf("%d", a[i]);

        if (i != 0)
        {
            printf(" ");
        }
    }
    return 0;
}
