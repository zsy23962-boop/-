#include <stdio.h>
#include <math.h>

#define EPS 1e-10

double f(double x, double a, double b, double c, double d)
{
    return a * x * x * x + b * x * x + c * x + d;
}

double binary_search(double l, double r,
                     double a, double b, double c, double d)
{
    double fl = f(l, a, b, c, d);
    double fr = f(r, a, b, c, d);
    if (fabs(fl) < EPS)
        return l;
    if (fabs(fr) < EPS)
        return r;

    for (int i = 0; i < 100; i++)
    {
        double mid = (l + r) / 2.0;
        double fm = f(mid, a, b, c, d);

        if (fabs(fm) < EPS)
            return mid;
        if (fl * fm < 0)
        {
            r = mid;
            fr = fm;
        }
        else
        {
            l = mid;
            fl = fm;
        }
    }

    return (l + r) / 2.0;
}

int main()
{
    double a, b, c, d;

    scanf("%lf %lf %lf %lf", &a, &b, &c, &d);

    double delta = b * b - 3.0 * a * c;
    double x1 = (-b - sqrt(delta)) / (3.0 * a);
    double x2 = (-b + sqrt(delta)) / (3.0 * a);

    if (x1 > x2)
    {
        double temp = x1;
        x1 = x2;
        x2 = temp;
    }

    double root[3];

    root[0] = binary_search(-100.0, x1, a, b, c, d);
    root[1] = binary_search(x1, x2, a, b, c, d);
    root[2] = binary_search(x2, 100.0, a, b, c, d);

    for (int i = 0; i < 3; i++)
    {
        if (fabs(root[i]) < 0.0005)
            root[i] = 0.0;
    }

    printf("%.2f %.2f %.2f\n", root[0], root[1], root[2]);

    return 0;
}
