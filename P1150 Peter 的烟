#include <stdio.h>

int main() {
    int n, k;

    while (scanf("%d %d", &n, &k) != EOF) {
        int total = n;
        int heads = n;
        
        while (heads >= k) {
            int new_cigs = heads / k; 
            total += new_cigs;
            
            heads = (heads % k) + new_cigs; 
        }
        printf("%d\n", total);
    }
    return 0;
}
