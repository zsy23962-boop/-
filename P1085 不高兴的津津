#include <stdio.h>
int main()
{
    int a, b;
    int sum;
    int unhappy;
    int emotionmax = 0;
    int day = 0;

    for (int i = 1; i <= 7; i++)
    {
        scanf("%d %d", &a, &b);
        sum = a + b;
        
        if (sum > 8)
        {
            unhappy = sum - 8;

            if (unhappy > emotionmax)
            {
                emotionmax = unhappy;
                day = i;
            }
        }
    }
    printf("%d\n", day);

    return 0;
}
