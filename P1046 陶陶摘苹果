#include <stdio.h>

int main()
{
    int apple[10];
    int height;
    int count = 0;

    for (int i = 0; i < 10; i++)
    {
        scanf("%d", &apple[i]);
    }
    scanf("%d", &height);
    height = height + 30;

    for (int i = 0; i < 10; i++)
    {
        if (apple[i] <= height)
        {
            count++;
        }
    }
    printf("%d\n", count);
    return 0;
}
